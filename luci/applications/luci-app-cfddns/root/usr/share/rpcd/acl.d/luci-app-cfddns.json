{
	"luci-app-cfddns": {
		"description": "Grant access to Cloudflare DDNS configuration, status and service control",
		"read": {
			"file": {
				"/etc/init.d/cfddns enabled": [ "exec" ],
				"/var/run/cfddns.status": [ "read" ],
				"/usr/bin/cfddns -inspect": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ],
				"service": [ "list" ]
			},
			"uci": [ "cfddns" ]
		},
		"write": {
			"file": {
				"/usr/libexec/cfddns-config": [ "exec" ],
				"/etc/init.d/cfddns start": [ "exec" ],
				"/etc/init.d/cfddns stop": [ "exec" ],
				"/etc/init.d/cfddns restart": [ "exec" ],
				"/etc/init.d/cfddns enable": [ "exec" ],
				"/etc/init.d/cfddns disable": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"uci": [ "commit" ]
			},
			"uci": [ "cfddns" ]
		}
	}
}
