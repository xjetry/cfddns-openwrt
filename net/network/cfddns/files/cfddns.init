#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # USE_PROCD, START and STOP are read by rc.common
# Cloudflare DDNS (cfddns). /etc/config/cfddns is the configuration; the env
# file cfddns reads is derived from it by /usr/libexec/cfddns-config, so the
# command line below never carries the Token.

USE_PROCD=1
START=95
STOP=10

uci_enabled() {
	cfddns_enabled=0
	config_load cfddns
	config_get_bool cfddns_enabled main enabled 0
	[ "$cfddns_enabled" = 1 ]
}

start_service() {
	uci_enabled || return 0
	/usr/libexec/cfddns-config || return 1

	procd_open_instance
	procd_set_param command /usr/bin/cfddns -status-file /var/run/cfddns.status
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/cfddns.status
}

reload_service() {
	/usr/libexec/cfddns-config || return 1
	if uci_enabled; then
		restart
	else
		stop
	fi
}
